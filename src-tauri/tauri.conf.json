{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ObsidianRECORDER Desktop",
  "version": "0.1.0",
  "identifier": "com.spasfonk.obsidianrecorder.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "ObsidianRECORDER Desktop",
        "width": 480,
        "height": 680,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
